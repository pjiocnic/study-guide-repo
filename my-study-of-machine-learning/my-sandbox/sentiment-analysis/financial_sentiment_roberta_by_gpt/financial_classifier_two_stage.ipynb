   "source": [
    "# 🔸 Two-Stage Financial Sentiment + Relevance Classifier (RoBERTa)"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "source": [
    "import pandas as pd
",
    "from datasets import Dataset
",
    "from transformers import AutoTokenizer, AutoModelForSequenceClassification, Trainer, TrainingArguments
",
    "import numpy as np
",
    "from sklearn.metrics import classification_report
",
    "
",
    "# Step 1: Simulate Dataset
",
    "data = {
",
    "    "text": [
",
    "        "Company X reported a record profit this quarter.",
",
    "        "Profit increase reported by Company V, but unrelated to core business.",
",
    "        "Company Z is facing a lawsuit.",
",
    "        "Company W report was inconclusive."
",
    "    ],
",
    "    "sentiment": [0, 0, 1, 2],  # 0=positive, 1=negative, 2=neutral/inconclusive
",
    "    "relevance": [1, 0, 1, 2]   # 0=irrelevant, 1=relevant, 2=inconclusive
",
    "}
",
    "df = pd.DataFrame(data)
",
    "
",
    "# Tokenize
",
    "tokenizer = AutoTokenizer.from_pretrained("roberta-base")
",
    "dataset = Dataset.from_pandas(df)
",
    "tokenized_dataset = dataset.map(lambda e: tokenizer(e['text'], truncation=True, padding=True), batched=True)
",
    "
",
    "# Train separate model for sentiment
",
    "model_sentiment = AutoModelForSequenceClassification.from_pretrained("roberta-base", num_labels=3)
",
    "training_args_sentiment = TrainingArguments(output_dir="./sentiment", per_device_train_batch_size=2, num_train_epochs=3)
",
    "trainer_sentiment = Trainer(model=model_sentiment, args=training_args_sentiment, train_dataset=tokenized_dataset.remove_columns(['text', 'relevance']), tokenizer=tokenizer)
",
    "trainer_sentiment.train()
",
    "
",
    "# Train separate model for relevance
",
    "model_relevance = AutoModelForSequenceClassification.from_pretrained("roberta-base", num_labels=3)
",
    "training_args_relevance = TrainingArguments(output_dir="./relevance", per_device_train_batch_size=2, num_train_epochs=3)
",
    "trainer_relevance = Trainer(model=model_relevance, args=training_args_relevance, train_dataset=tokenized_dataset.remove_columns(['text', 'sentiment']), tokenizer=tokenizer)
",
    "trainer_relevance.train()"
   ]
  }
 ],
