# ✅ Step 2: Imports

# ✅ Step 3: Load the Sample JSON File (Upload this to /content)
with open("/content/deep_nested_users.json") as f:
    data = json.load(f)

# ✅ Preview one user record
pprint(data[0])

# ✅ Step 4: Define Flattening Schema
schema = {
    "id": "id",
    "name": "name",
    "geo_lat": "address.geo.lat",
    "geo_long": "address.geo.long",
    "street": "address.street",
    "city": "address.city",
    "home_phone": "phones.0.number",
    "work_phone": "phones.1.number",
    "current_company": "employment.current.company",
    "current_role": "employment.current.role",
    "office_floor": "employment.current.location.building.floor",
    "previous_roles": "employment.history[].role"
}

# ✅ Step 5: Define General-Purpose Safe Flattener


def safe_glom(record, schema):
    result = {}
    for key, path in schema.items():
        try:
            result[key] = glom(record, path)
        except PathAccessError:
            result[key] = np.nan  # Use NaN if field is missing
    return result

# ✅ Expand list-type fields (like previous_roles) into columns


def expand_list_column(df, colname, max_items=3):
    for i in range(max_items):
        df[f"{colname}_{i+1}"] = df[colname].apply(
            lambda x: x[i] if isinstance(x, list) and len(x) > i else np.nan)
    return df.drop(columns=[colname])


# ✅ Step 6: Flatten all user records
flattened = [safe_glom(user, schema) for user in data]
df = pd.DataFrame(flattened)

# ✅ Step 7: Expand list fields
df = expand_list_column(df, "previous_roles", max_items=3)

# ✅ Step 8: View the Final DataFrame
df
